# Postgres 15+/PostGIS 3.4+ connection string.
# Local: `docker compose up -d` brings up the postgis service below.
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kya
# Cloud: Supabase project -> Settings -> Database (enable PostGIS via
# Dashboard -> Database -> Extensions first), then paste the connection string.
DATABASE_URL=

# Cloudflare R2 (S3-compatible) object storage for complaint photos.
# R2 dashboard -> Manage R2 API Tokens to create an access key pair,
# and the bucket's Settings tab for the account ID and public base URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
